PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/repp?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:YOUR_PASSWORD@localhost:5432/repp?schema=public"
JWT_SECRET="repp_super_secret_jwt_key_2026_change_in_production"
CLIENT_ORIGIN="http://localhost:5173"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TEXT_MODEL="llama3.2:3b"
OLLAMA_VISION_MODEL="gemma3:4b"
OLLAMA_TIMEOUT_MS=180000
UPLOAD_DIR="./uploads"

# Google sign-in: OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# Public identifier, not a secret. No client secret is needed. Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=""

# Cloud AI (Anthropic). Leave empty to run everything on local Ollama.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-haiku-5-5"

# Hosting
# BodyVision body photos: "ollama" (private, needs Ollama) or "claude" (needed on Vercel, no Ollama there)
BODYVISION_AI="ollama"
# Shared account behind the "Try the demo" button; empty disables the button
DEMO_EMAIL="demo3m@repp.app"
# Vercel Cron secret for the daily demo reset (any long random string)
CRON_SECRET=""
